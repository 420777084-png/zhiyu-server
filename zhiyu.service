[Unit]
Description=知愈医学内容管理服务
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zhiyu-server
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
EnvironmentFile=/opt/zhiyu-server/.env

# 安全限制
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
